<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Student Portal</title>
    <!-- Link to your existing external stylesheet -->
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Header and Navigation -->
    <header>
        <h1>Student Portal</h1>
        <nav>
            <a href="index.html">Home</a>
            <a href="login.html" class="active">Login</a>
        </nav>
    </header>

    <main>
        <!-- Login Section -->
        <section>
            <h2>Student Portal Login</h2>
            <p>Please enter your credentials to access your profile and course details.</p>
            
            <form action="index.html" method="GET">
                <fieldset>
                    <legend>Sign In</legend>
                    
                    <label for="login-email">Email Address:</label>
                    <input type="email" id="login-email" placeholder="name@example.com" required>

                    <label for="login-password">Password:</label>
                    <input type="password" id="login-password" placeholder="Enter your password" required>

                    <button type="submit">Login</button>
                    <button type="reset" style="background-color: #7f8c8d;">Clear</button>
                </fieldset>
            </form>
            
            <p style="margin-top: 20px; font-size: 0.9rem;">
                Don't have an account? Contact your department administrator.
            </p>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 Student Portal | Skill Lab Module 1</p>
    </footer>
</body>
</html>